{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash

echo "Installing common brew packages..."
brew bundle --file=/dev/stdin <<EOF
{{ range .packages.darwin.common.brews -}}
brew {{ . | quote }}
{{ end -}}
{{ range .packages.darwin.common.casks -}}
cask {{ . | quote }}
{{ end -}}
EOF
{{ end -}}

{{ if eq .personal.enabled true -}}
echo "Installing personal brew packages..."
brew bundle --file=/dev/stdin <<EOF
{{ range .packages.darwin.personal.brews -}}
brew {{ . | quote }}
{{ end -}}
{{ range .packages.darwin.personal.casks -}}
cask {{ . | quote }}
{{ end -}}
EOF
{{ end -}}
