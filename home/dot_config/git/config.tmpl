# Ref: https://git-scm.com/docs/git-config

[user]
    name = {{ .git_name }}
    email = {{ .git_email }}

# signingkey = {# { .git_signing_key } #}

[init]
    defaultBranch = main

[core]
    editor = code --wait

[commit]
    gpgSign = true

[url "git@github.com:"]
    insteadOf = https://github.com/
