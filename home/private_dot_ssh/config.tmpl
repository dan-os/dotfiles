# Ref: https://wiki.archlinux.org/index.php/OpenSSH

ServerAliveInterval 120

HashKnownHosts no

{{- if eq .chezmoi.os "darwin" }}

Host *
  AddKeysToAgent yes
  UseKeychain yes

# autogenerated by step @ 0000-00-00T00:00:00Z
Host *
  Include "/Users/dan/.step/ssh/includes"
# end

{{- end }}

Host github.com
  AddKeysToAgent yes
  UseKeychain yes
  IdentityFile ~/.ssh/id_ed25519
